# 실제 키를 넣는 곳. 깃에 안 올라간다(.gitignore).
# 붙여넣을 때 = 뒤에 값만 붙인다. 따옴표·빈칸 없이.

# 지방재정365 (행안부) — 이 키 하나로 146종이 전부 열린다. ✔ 들어와 있다
LOFIN_KEY=

# data.go.kr 조달청 — 이 키 하나로 5종이 한꺼번에 열린다:
#   나라장터 계약정보 · 낙찰정보 · 입찰공고 · 계약과정통합공개 + 국고보조금 정보
# 어디서 — data.go.kr 로그인 → 마이페이지 → 개발계정 상세보기 → 일반 인증키(Decoding)
# ⚠️ **Decoding** 값을 넣을 것. Encoding 값(%2B·%3D 가 섞인 것)을 넣으면 조용히 실패한다.
# 넣은 뒤 확인 — python scripts/probe_g2b.py
DATA_GO_KR_KEY=

# 지방교육재정알리미 (교육부) — 17개 시·도교육청 예산공시 295종 · 결산공시 325종
#   보조사업명 · 보조사업자 · 집행액 · 최종정산액이 나온다(받는 쪽 이름이 보이는 드문 자료)
# 어디서 — GPT 가 이미 발급받아 실호출까지 해 본 키가 있다. 그걸 받아 넣으면 된다.
EDU_ALIMI_KEY=

# 열린재정 (기재부) — 중앙정부 총량이라 자치단체로 안 쪼개진다. 후순위, 아직 안 쓴다.
